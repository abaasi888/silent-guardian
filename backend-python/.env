# Server
APP_NAME=Silent Guardian API
DEBUG=True
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=silent_guardian

# Redis (for caching and jobs)
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-please-use-strong-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin
ADMIN_EMAIL=admin@silentguardian.com
ADMIN_PASSWORD=admin123

# Frontend URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=support@silentguardian.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Crypto (USDT - TRC20/ERC20/BEP20)
CRYPTO_WALLET_TRC20=TXuZVqQ8UQrLkqkLkqkLkqkLkqkLkqkL
CRYPTO_WALLET_ERC20=0x742d35Cc6634C0532925a3b844Bc9e7595f0b0a0
CRYPTO_WALLET_BEP20=0x742d35Cc6634C0532925a3b844Bc9e7595f0b0a0

# Mobile Money (MTN Uganda)
MTN_API_URL=https://sandbox.mtn.co.ug/momo
MTN_SUBSCRIPTION_KEY=your_subscription_key
MTN_API_USER=your_api_user
MTN_API_KEY=your_api_key

# Mobile Money (Airtel Uganda)
AIRTEL_API_URL=https://openapi.airtel.ug/merchant
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret

# Stripe (Visa/Mastercard)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# QR Code
QR_CODE_BASE_URL=https://silentguardian.com/pay