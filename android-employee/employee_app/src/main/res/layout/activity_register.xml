<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employee Registration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Personal Information Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name *"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email *"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password *"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm Password *"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etInviteCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Invite Code"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="20dp" />

        <!-- Documents Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Documents"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- ID Document -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnUploadId"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📄 Upload ID"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIdStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:gravity="center"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- Selfie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnUploadSelfie"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📸 Upload Selfie"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSelfieStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- CV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnUploadCV"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📄 Upload CV"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCVStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- NSSF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnUploadNSSF"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📄 Upload NSSF"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNSSFStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- Bank Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnUploadBankAccount"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🏦 Upload Bank Account"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBankStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- Academics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnUploadAcademics"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🎓 Upload Academics"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAcademicsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not uploaded"
                android:textColor="@color/gray"
                android:paddingStart="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Register"
            android:backgroundTint="@color/success_green"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>